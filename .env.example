# Berry local stack — copy to `.env`, then run `docker compose up -d --build`.
# `.env` is gitignored. Defaults are for loopback-only local development, not production.

# ─── Berry API ────────────────────────────────────────────────────────
# Compose binds the API to host loopback and uses API_ADDR=0.0.0.0:4000 internally.
BERRY_API_PORT=4000
APP_ENV=development
SERVICE_NAME=berry-server

# ─── Berry Postgres (durable product state) ──────────────────────────
# PostgreSQL 16 remains on the existing berry-postgres volume. Do not point a
# PostgreSQL 17 image at that volume; use the documented dump/restore upgrade path.
POSTGRES_USER=berry
POSTGRES_PASSWORD=berry
POSTGRES_DB=berry
POSTGRES_PORT=5432
# Container-to-container URL used by berry-api. Keep credentials synchronized
# with POSTGRES_* when changing the local defaults.
BERRY_DATABASE_URL=postgres://berry:berry@postgres:5432/berry?sslmode=disable

# ─── Berry auth ───────────────────────────────────────────────────────
SESSION_TTL=720h
# Development-only escape hatch; the server rejects it in production.
AUTH_ALLOW_PASSWORDLESS_LOGIN=true

# ─── Realtime ─────────────────────────────────────────────────────────
# Per-subscriber event buffer, before a slow client is dropped. The streams
# replay from PostgreSQL, so a dropped subscriber loses nothing on reconnect.
REALTIME_BUFFER=64

# ─── Agent execution ──────────────────────────────────────────────────
# The model credential agents run on. Without it the server reports
# agentExecution false and refuses run requests rather than accepting ones it
# cannot serve. Server-side only: never mirror this into a NEXT_PUBLIC_*.
#
# BERRY_-prefixed on purpose: a stale OPENROUTER_API_KEY exported in the
# launching shell outranks .env for Compose substitution, and nothing exports
# the namespaced name.
BERRY_OPENROUTER_API_KEY=
# Used when an agent row names no model of its own.
BERRY_AGENT_DEFAULT_MODEL=anthropic/claude-sonnet-4.5
# The shared secret an internal caller presents to POST /internal/runs. Empty
# turns that surface off entirely rather than leaving it open — it runs agents
# and spends money. Generate one per deployment:
#   openssl rand -base64 32
BERRY_INTERNAL_TOKEN=

# ─── Execution substrate (where an agent's commands run) ──────────────
# Unset means agents cannot run commands at all: the server installs a driver
# that refuses every call and names what is missing, rather than failing
# somewhere further in.
#
# `docker` is the runtime service in runtime/, which runs one container per run
# on this host's own daemon. It is the default and needs nothing but Docker.
#
# `cloudflare` is the hosted workspace: a Worker fronting a Sandbox Durable
# Object, deployed from runtime-worker/. It needs a Workers Paid plan and
# cannot be self-hosted. Both speak the same protocol, so switching is a URL.
BERRY_RUNTIME_DRIVER=docker
# Where that substrate is. The compose default reaches the runtime service.
# Must be https outside loopback: the token below is sent on every request.
BERRY_RUNTIME_URL=http://runtime:4300
# Shared by berry-api and the runtime service — they must match, and an empty
# value makes the runtime refuse every call rather than leaving an
# unauthenticated command runner on the network. Generate with:
#   openssl rand -base64 32
BERRY_RUNTIME_TOKEN=

# --- The sandbox a run gets ---------------------------------------------------
# Built by the `sandbox-image` compose service from runtime/sandbox/Dockerfile.
BERRY_SANDBOX_IMAGE=berry-sandbox:local
BERRY_SANDBOX_WORKDIR=/workspace
# Modest on purpose: a runaway run must not be able to take the host down
# because nothing was set. Containers also run with all capabilities dropped.
BERRY_SANDBOX_MEMORY_MB=2048
BERRY_SANDBOX_CPUS=1
# A fork bomb is the cheapest way for generated code to take a host down.
BERRY_SANDBOX_PIDS=512
# Agents install packages and clone repositories. `none` turns that off.
BERRY_SANDBOX_NETWORK=bridge
# Over this ceiling the runtime answers 429, which Berry retries rather than
# recording the run as failed.
BERRY_SANDBOX_MAX_CONTAINERS=8
# Loopback-only debugging port for the runtime service.
RUNTIME_PORT=4300

# ─── Berry storage (ADR-0006) ─────────────────────────────────────────
# Artifacts live in object storage. The compose stack runs MinIO, so
# development exercises the same S3 code path as deployment rather than a local
# filesystem that behaves differently under presigning.
# Caps a single object. It does not cap total artifact spend — retention is not
# yet decided (ADR-0006 follow-up).
STORAGE_MAX_BYTES=26214400
S3_BUCKET=berry-artifacts
S3_REGION=us-east-1
# Enables MinIO/custom endpoints; leave empty for real AWS. The default in
# docker-compose.yml points at the MinIO service.
S3_ENDPOINT=
# MinIO addresses buckets by path, not by subdomain.
S3_USE_PATH_STYLE=true
# Server-side only. Empty values use the AWS workload/instance credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# MinIO's published ports. Loopback-only: these are weak development
# credentials and the console has no authentication worth exposing.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Frontend same-origin transport ───────────────────────────────────
# Copy these to frontend/.env.local when running Next.js on the host.
# BERRY_API_ORIGIN is server-only and defaults to this value in next.config.ts.
# A future frontend container on this network can use http://berry-api:4000.
BERRY_API_ORIGIN=http://127.0.0.1:4000
# Browser-visible cross-origin development escape hatch. Leave empty to use
# same-origin rewrites. Never put credentials or upstream URLs in NEXT_PUBLIC_*.
NEXT_PUBLIC_BERRY_API_URL=
NEXT_PUBLIC_BOARD_ID=
NEXT_PUBLIC_WORKSPACE_SLUG=berry
NEXT_PUBLIC_WORKSPACE_NAME=Berry
NEXT_PUBLIC_ISSUE_PREFIX=BERRY
