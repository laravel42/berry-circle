# Berry local stack (docker-compose.yml) — copy to `.env`, then `docker compose up -d --build`.
# Every value has a working default in the compose file; you only need to set an LLM
# provider key to make OpenFang actually run agents. `.env` is gitignored.

# ─── OpenFang pin (ADR-0003) ─────────────────────────────────────────
# Authoritative pin lives in deploy/openfang.pin.json. Override here ONLY for a reviewed
# upgrade, and keep both in sync. Full 40-char commit SHA; short SHA tags the built image.
# OPENFANG_COMMIT=acf2587e46be174c10200489c9a2d23a39a98aeb
# OPENFANG_COMMIT_SHORT=acf2587e

# ─── OpenFang runtime ────────────────────────────────────────────────
OPENFANG_PORT=4200
# Bearer token for the substrate. Empty = fail-closed (only loopback + public routes).
# Set the SAME value as apps/gateway OPENFANG_API_KEY so the gateway can authenticate.
OPENFANG_API_KEY=
OPENFANG_LOG=info
# Faster local builds; set LTO=true / CODEGEN_UNITS=1 for a release-optimized binary.
OPENFANG_BUILD_LTO=false
OPENFANG_BUILD_CODEGEN_UNITS=16

# ─── LLM providers (set only what you use) ───────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Qwen via a local vLLM server (parent issue BERR-2). From inside the container the host
# is host.docker.internal, e.g. VLLM_BASE_URL=http://host.docker.internal:8000
VLLM_BASE_URL=
VLLM_API_KEY=
OLLAMA_BASE_URL=

# ─── Berry Postgres (durable product state) ──────────────────────────
# Defaults match apps/gateway/.env.example DATABASE_URL=postgres://berry:berry@localhost:5432/berry
POSTGRES_USER=berry
POSTGRES_PASSWORD=berry
POSTGRES_DB=berry
POSTGRES_PORT=5432

# ─── Berry Valkey (cache + ephemeral coordination) ───────────────────
VALKEY_PORT=6379
