# Berry local stack — copy to `.env`, then run `docker compose up -d --build`.
# `.env` is gitignored. Defaults are for loopback-only local development, not production.

# ─── OpenFang pin (ADR-0003) ─────────────────────────────────────────
# Authoritative pin lives in deploy/openfang.pin.json. Override here ONLY for a reviewed
# upgrade, and keep both in sync. Full 40-char commit SHA; short SHA tags the built image.
# OPENFANG_COMMIT=acf2587e46be174c10200489c9a2d23a39a98aeb
# OPENFANG_COMMIT_SHORT=acf2587e

# ─── OpenFang runtime ────────────────────────────────────────────────
OPENFANG_PORT=4200
# Server-side substrate bearer token. Never copy this into NEXT_PUBLIC_*.
# Empty keeps authenticated OpenFang routes fail-closed; set a strong value for agent work.
OPENFANG_API_KEY=
OPENFANG_LOG=info
# Faster local builds; set LTO=true / CODEGEN_UNITS=1 for a release-optimized binary.
OPENFANG_BUILD_LTO=false
OPENFANG_BUILD_CODEGEN_UNITS=16

# ─── LLM providers (set only what you use) ───────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Qwen via a local vLLM server (parent issue BERR-2). From inside the container the host
# is host.docker.internal, e.g. VLLM_BASE_URL=http://host.docker.internal:8000
VLLM_BASE_URL=
VLLM_API_KEY=
OLLAMA_BASE_URL=

# ─── Berry Go API ─────────────────────────────────────────────────────
# Compose binds the API to host loopback and uses API_ADDR=0.0.0.0:4000 internally.
BERRY_API_PORT=4000
APP_ENV=development
SERVICE_NAME=berry-server
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s

# ─── Berry Postgres (durable product state) ──────────────────────────
# PostgreSQL 16 remains on the existing berry-postgres volume. Do not point a
# PostgreSQL 17 image at that volume; use the documented dump/restore upgrade path.
POSTGRES_USER=berry
POSTGRES_PASSWORD=berry
POSTGRES_DB=berry
POSTGRES_PORT=5432
# Container-to-container URL used by berry-api. Keep credentials synchronized
# with POSTGRES_* when changing the local defaults.
BERRY_DATABASE_URL=postgres://berry:berry@postgres:5432/berry?sslmode=disable

# ─── Berry Valkey (cache + ephemeral coordination) ───────────────────
VALKEY_PORT=6379
BERRY_VALKEY_URL=redis://valkey:6379/0
VALKEY_ENABLED=true
VALKEY_REQUIRED=true
CACHE_FAIL_OPEN=true
RATE_LIMIT_FAIL_OPEN=false

# ─── Multi-instance realtime relay ────────────────────────────────────
REALTIME_BUFFER=64
# Blank generates a unique id per API process; set an explicit safe id per replica if needed.
REALTIME_NODE_ID=
# Compose requires the Valkey relay so /ready fails when cross-node fanout is unavailable.
REALTIME_RELAY_REQUIRED=true
REALTIME_STREAM_MAXLEN=10000
REALTIME_STREAM_TTL=15m
REALTIME_READ_BLOCK=5s

# ─── Berry auth and browser trust ─────────────────────────────────────
SESSION_TTL=720h
# Development-only escape hatch; the server ignores/rejects it in production.
AUTH_ALLOW_PASSWORDLESS_LOGIN=true
# Comma-separated frontend origins accepted by API origin checks/CORS.
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Berry storage ────────────────────────────────────────────────────
# Local objects persist in the berry-uploads volume at /data/uploads.
STORAGE_BACKEND=local
STORAGE_MAX_BYTES=26214400
# S3-compatible production storage. S3_ENDPOINT enables MinIO/custom endpoints.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
# Empty selects path-style automatically for custom endpoints; set true/false explicitly
# when the endpoint requires a specific addressing mode.
S3_USE_PATH_STYLE=
# Server-side only. Empty values use the AWS workload/instance credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── Berry metrics ────────────────────────────────────────────────────
METRICS_ENABLED=true

# ─── Frontend same-origin transport ───────────────────────────────────
# Copy these to frontend/.env.local when running Next.js on the host.
# BERRY_API_ORIGIN is server-only and defaults to this value in next.config.ts.
# A future frontend container on this network can use http://berry-api:4000.
BERRY_API_ORIGIN=http://127.0.0.1:4000
# Browser-visible cross-origin development escape hatch. Leave empty to use
# same-origin rewrites. Never put credentials or OpenFang URLs in NEXT_PUBLIC_*.
NEXT_PUBLIC_BERRY_API_URL=
NEXT_PUBLIC_BOARD_ID=
NEXT_PUBLIC_WORKSPACE_SLUG=berry
NEXT_PUBLIC_WORKSPACE_NAME=Berry
NEXT_PUBLIC_ISSUE_PREFIX=BERRY

# --- Durable run orchestration (ADR-0005) -----------------------------------
# Temporal drives run dispatch and continuous task intake. Disabled selects the
# in-process dispatcher, which is a supported configuration.
# Start the stack with: docker compose --profile temporal up -d --build
TEMPORAL_ENABLED=false
TEMPORAL_REQUIRED=false
TEMPORAL_HOSTPORT=temporal:7233
TEMPORAL_NAMESPACE=berry
TEMPORAL_TASK_QUEUE=berry-runs
TEMPORAL_PORT=7233
# Operator UI, off unless --profile temporal-ui is used. It exposes run
# payloads, so it is not part of the product surface.
TEMPORAL_UI_PORT=8233

# --- Continuous intake ------------------------------------------------------
# Pulls issues in `todo` whose assigned agent is `available` and dispatches
# them. Requires TEMPORAL_ENABLED=true.
INTAKE_ENABLED=false
INTAKE_INTERVAL=10s
INTAKE_BATCH_SIZE=10
# Concurrent agent runs Berry will hold open. Every run costs provider tokens,
# so treat this as a spend ceiling and not only a throughput knob.
INTAKE_MAX_CONCURRENT=8
# The users.id automated runs are attributed to. Defaults to the system actor
# seeded by migration 009; override only to attribute intake to someone else.
INTAKE_ACTOR_ID=

# --- Built-in orchestrator --------------------------------------------------
# Every workspace carries one protected orchestrator agent that cannot be
# deleted and which takes intake work when the workspace has defined no other
# agent. It only becomes usable once it exists in OpenFang, which needs a model
# choice — Berry does not pick an LLM for you. Leave these unset and the
# orchestrator stays offline and is skipped by intake.
ORCHESTRATOR_PROVIDER=
ORCHESTRATOR_MODEL=
