APP_ENV=development
SERVICE_NAME=berry-server
LOG_LEVEL=info
API_ADDR=0.0.0.0:4000

# Required in production. PostgreSQL is authoritative for all durable facts.
DATABASE_URL=postgres://berry:berry@127.0.0.1:5432/berry?sslmode=disable

# Valkey is disposable. Required mode fails readiness when unavailable.
VALKEY_ENABLED=false
VALKEY_REQUIRED=false
VALKEY_URL=redis://127.0.0.1:6379/0
CACHE_FAIL_OPEN=true
RATE_LIMIT_FAIL_OPEN=false

# Server-side only. Never prefix the key with NEXT_PUBLIC_ or return it to clients.
OPENFANG_BASE_URL=http://127.0.0.1:4200
OPENFANG_API_KEY=

METRICS_ENABLED=true
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/uploads
STORAGE_MAX_BYTES=26214400
# S3 is a configuration seam until its implementation lane lands.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

SESSION_TTL=720h
AUTH_ALLOW_PASSWORDLESS_LOGIN=false
SHUTDOWN_TIMEOUT=15s
REALTIME_BUFFER=64
