{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "berry-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // One container class, one image. Cloudflare binds the image to the
  // deployment rather than to the request, so an agent's "runtime image" can
  // only be chosen from images declared here — see PROTOCOL.md. Adding a
  // second toolchain means a second class and a second binding, not a
  // parameter.
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      // `lite` is 1/16 vCPU and 256 MiB — enough for the SDK's examples and
      // nowhere near enough to install a dependency tree. A coding agent needs
      // room to check out a repository and run its tests.
      "instance_type": "standard-2",
      "max_instances": 10
    }
  ],

  "durable_objects": {
    "bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
  },

  "migrations": [{ "new_sqlite_classes": ["Sandbox"], "tag": "v1" }],

  "observability": {
    "enabled": true
  }

  // BERRY_RUNTIME_TOKEN is set with `wrangler secret put`, never here.
  // It is the only credential between Berry and this worker.
}
