{
   "name": "berry-circle",
   "private": true,
   "packageManager": "pnpm@10.12.1",
   "pnpm": {
      "onlyBuiltDependencies": [
         "@biomejs/biome",
         "esbuild",
         "sharp",
         "unrs-resolver"
      ]
   },
   "scripts": {
      "dev:frontend": "pnpm --filter berry-frontend dev",
      "dev:gateway": "pnpm --filter @berry/gateway dev",
      "lint:frontend": "pnpm --filter berry-frontend lint",
      "lint:gateway": "pnpm --filter @berry/gateway lint",
      "build:frontend": "pnpm --filter berry-frontend build",
      "build:gateway": "pnpm --filter @berry/gateway build",
      "typecheck:gateway": "pnpm --filter @berry/gateway typecheck",
      "test:gateway": "pnpm --filter @berry/gateway test",
      "typecheck:server": "pnpm --filter @berry/server typecheck",
      "test:server": "pnpm --filter @berry/server test",
      "dev:server": "pnpm --filter @berry/server dev"
   }
}
