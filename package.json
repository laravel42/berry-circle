{
   "name": "berry-circle",
   "private": true,
   "packageManager": "pnpm@10.12.1",
   "pnpm": {
      "onlyBuiltDependencies": [
         "@biomejs/biome",
         "esbuild",
         "sharp",
         "unrs-resolver"
      ]
   },
   "scripts": {
      "dev:frontend": "pnpm --filter berry-frontend dev",
      "lint:frontend": "pnpm --filter berry-frontend lint",
      "build:frontend": "pnpm --filter berry-frontend build",
      "dev:server": "pnpm --filter @berry/server dev",
      "typecheck:server": "pnpm --filter @berry/server typecheck",
      "test:server": "pnpm --filter @berry/server test",
      "migrate:server": "pnpm --filter @berry/server migrate",
      "seed:server": "pnpm --filter @berry/server seed",
      "typecheck:worker": "pnpm --filter @berry/runtime-worker typecheck",
      "test:worker": "pnpm --filter @berry/runtime-worker test",
      "deploy:worker": "pnpm --filter @berry/runtime-worker deploy",
      "typecheck:runtime": "pnpm --filter @berry/runtime typecheck",
      "test:runtime": "pnpm --filter @berry/runtime test",
      "dev:runtime": "pnpm --filter @berry/runtime dev"
   }
}
