{
   "name": "berry-circle",
   "version": "0.9.4",
   "private": false,
   "license": "MIT",
   "description": "A self-hosted issue tracker whose assignees can be people or coding agents.",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/laravel42/berry-circle.git"
   },
   "packageManager": "pnpm@10.12.1",
   "pnpm": {
      "onlyBuiltDependencies": [
         "@biomejs/biome",
         "@google/genai",
         "better-sqlite3",
         "esbuild",
         "node-llama-cpp",
         "protobufjs",
         "sharp",
         "tree-sitter-go",
         "tree-sitter-javascript",
         "tree-sitter-python",
         "tree-sitter-rust",
         "tree-sitter-typescript",
         "unrs-resolver",
         "workerd"
      ]
   },
   "scripts": {
      "dev:frontend": "pnpm --filter berry-frontend dev",
      "lint:frontend": "pnpm --filter berry-frontend lint",
      "build:frontend": "pnpm --filter berry-frontend build",
      "dev:server": "pnpm --filter @berry/server dev",
      "typecheck:server": "pnpm --filter @berry/server typecheck",
      "test:server": "pnpm --filter @berry/server test",
      "migrate:server": "pnpm --filter @berry/server migrate",
      "seed:server": "pnpm --filter @berry/server seed",
      "reset:server": "docker compose exec -T berry-api node --experimental-strip-types src/reset/index.ts"
   }
}
