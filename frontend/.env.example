# Berry frontend configuration.
# Copy to .env.local and adjust.

# Server-only upstream used by Next.js rewrites. It is never included in the
# browser bundle. Host development uses loopback; a containerized frontend on
# the Compose network can use http://berry-api:4000.
BERRY_API_ORIGIN=http://127.0.0.1:4000

# Explicit cross-origin development escape hatch. Leave empty for the default
# same-origin transport through Next.js. This value is browser-visible and must
# never contain a token, OpenFang URL, or other secret.
NEXT_PUBLIC_BERRY_API_URL=

# UUID of a board to pin the issue list to. Empty lets the signed-in session
# pick the first board returned by GET /api/v1/boards.
NEXT_PUBLIC_BOARD_ID=

# Browser requests include same-origin cookies. Bearer sessions are supplied at
# runtime through lib/api.ts's in-memory session seam, never through an env var.

# URL segment for workspace routes (/{WORKSPACE_SLUG}/…) and display name.
NEXT_PUBLIC_WORKSPACE_SLUG=berry
NEXT_PUBLIC_WORKSPACE_NAME=Berry

# Prefix for issue identifiers created in this workspace (e.g. BERRY-123).
NEXT_PUBLIC_ISSUE_PREFIX=BERRY

# Skip the login screen and sign in with this email when no session exists.
# Set empty to restore the login flow later.
NEXT_PUBLIC_AUTO_LOGIN_EMAIL=prototype@berry.test
