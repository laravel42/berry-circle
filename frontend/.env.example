# Berry frontend configuration.
# Copy to .env.local and adjust. All values are NEXT_PUBLIC_* — they are
# inlined into the client bundle at build time, so rebuild after changing.

# Base URL of the Berry gateway (BFF). Leave empty until the gateway (M2)
# is running; the app boots with empty data either way.
NEXT_PUBLIC_BERRY_API_URL=

# URL segment for workspace routes (/{WORKSPACE_SLUG}/…) and display name.
NEXT_PUBLIC_WORKSPACE_SLUG=berry
NEXT_PUBLIC_WORKSPACE_NAME=Berry

# Prefix for issue identifiers created in this workspace (e.g. BERRY-123).
NEXT_PUBLIC_ISSUE_PREFIX=BERRY
