# Berry frontend environment (copy to .env.local and edit).

# Base URL of the Berry gateway (BFF). Leave unset until the gateway exists;
# the app boots with empty data either way.
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Workspace identity used by workspace-scoped routes and branding.
NEXT_PUBLIC_WORKSPACE_SLUG=berry
NEXT_PUBLIC_WORKSPACE_NAME=Berry
NEXT_PUBLIC_ISSUE_PREFIX=BERRY
