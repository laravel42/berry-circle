# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Observability (Pino logging + OpenTelemetry metrics)
SERVICE_NAME=berry-gateway
# SERVICE_VERSION defaults to the package version when unset.
METRICS_ENABLED=true
METRICS_PATH=/metrics

# OpenFang substrate (OpenAI-compatible + REST API)
OPENFANG_BASE_URL=http://localhost:4200
OPENFANG_API_KEY=

# Postgres (Berry-owned product state; used by db:migrate, drizzle-kit, and request paths)
DATABASE_URL=postgres://berry:berry@localhost:5432/berry

# Auth sessions — lifetime of a login session token before it expires (hours). 720h = 30 days.
SESSION_TTL_HOURS=720

# Opt-in for credential-less "log in by known email" (no password check). MUST stay off for
# any network-exposed deploy; it is hard-ignored under NODE_ENV=production regardless. Only
# "true" enables it — any other value (incl. unset) leaves it disabled.
AUTH_ALLOW_PASSWORDLESS_LOGIN=false

# Valkey cache (ADR-0002) — optional performance cache for hot reads; fails open.
# All values have working defaults; set nothing to cache with the defaults below.
CACHE_ENABLED=true
VALKEY_URL=redis://127.0.0.1:6379
# Namespace + version baked into every key; bump the version to flush the cache.
CACHE_KEY_PREFIX=berry
CACHE_SCHEMA_VERSION=1
# Per-op timeout (ms): a slower Valkey op is abandoned and treated as a miss.
CACHE_OP_TIMEOUT_MS=250
# Per-family TTLs in seconds (issue lists churn most, so the shortest TTL).
CACHE_TTL_DEFAULT_SECONDS=30
CACHE_TTL_BOARD_SECONDS=60
CACHE_TTL_BOARDS_LIST_SECONDS=30
CACHE_TTL_ISSUE_SECONDS=30
CACHE_TTL_ISSUE_LIST_SECONDS=15
