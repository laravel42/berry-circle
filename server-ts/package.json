      "@google/genai": "^2.19.0",
      "@hono/node-server": "^2.1.1",
      "hono": "^4.13.5",
      "ioredis": "^6.0.0",
      "postgres": "^3.4.9",
      "zod": "^4.2.1"
   },
   "devDependencies": {
      "@types/node": "^26.4.0",
      "typescript": "^7.0.2"
